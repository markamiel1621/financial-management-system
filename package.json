{
  "name": "folio-fms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "generate": "bun --bun nuxt generate",
    "preview": "bun --bun nuxt preview",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun test tests",
    "db:generate": "bun --bun drizzle-kit generate",
    "presentation": "bun run generate && bun scripts/presentation.ts",
    "db:check": "bun scripts/check-database.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.113",
    "@nuxt/ui": "4.8.2",
    "drizzle-orm": "0.45.2",
    "nuxt": "4.4.6",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.1",
    "vue": "3.5.38",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.5"
  }
}
